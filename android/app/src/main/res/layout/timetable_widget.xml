                        android:ellipsize="end"
                        android:maxLines="1"/>
                        
                    <TextView
                        android:id="@+id/period4_classroom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textSize="11sp"
                        android:textColor="@color/widget_text_secondary"
                        android:ellipsize="end"
                        android:maxLines="1"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/period4_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="14:40-16:10"
                    android:textSize="10sp"
                    android:textColor="@color/widget_text_secondary"/>
            </LinearLayout>

            <View
                android:id="@+id/period4_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/widget_divider" />

            <!-- Period 5 -->
            <LinearLayout
                android:id="@+id/period5_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="6dp"
                android:gravity="center_vertical">
                
                <TextView
                    android:id="@+id/period5_number"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:gravity="center"
                    android:text="5"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_text_primary"
                    android:background="@drawable/widget_period_circle"/>
                    
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">
                    
                    <TextView
                        android:id="@+id/period5_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/widget_text_primary"
                        android:ellipsize="end"
                        android:maxLines="1"/>
                        
                    <TextView
                        android:id="@+id/period5_classroom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textSize="11sp"
                        android:textColor="@color/widget_text_secondary"
                        android:ellipsize="end"
                        android:maxLines="1"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/period5_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="16:15-17:45"
                    android:textSize="10sp"
                    android:textColor="@color/widget_text_secondary"/>
            </LinearLayout>

            <View
                android:id="@+id/period5_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/widget_divider" />

            <!-- Period 6 -->
            <LinearLayout
                android:id="@+id/period6_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="6dp"
                android:gravity="center_vertical">
                
                <TextView
                    android:id="@+id/period6_number"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:gravity="center"
                    android:text="6"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_text_primary"
                    android:background="@drawable/widget_period_circle"/>
                    
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">
                    
                    <TextView
                        android:id="@+id/period6_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/widget_text_primary"
                        android:ellipsize="end"
                        android:maxLines="1"/>
                        
                    <TextView
                        android:id="@+id/period6_classroom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textSize="11sp"
                        android:textColor="@color/widget_text_secondary"
                        android:ellipsize="end"
                        android:maxLines="1"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/period6_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="17:50-19:20"
                    android:textSize="10sp"
                    android:textColor="@color/widget_text_secondary"/>
            </LinearLayout>

            <View
                android:id="@+id/period6_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/widget_divider" />

            <!-- Period 7 -->
            <LinearLayout
                android:id="@+id/period7_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="6dp"
                android:gravity="center_vertical">
                
                <TextView
                    android:id="@+id/period7_number"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:gravity="center"
                    android:text="7"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_text_primary"
                    android:background="@drawable/widget_period_circle"/>
                    
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">
                    
                    <TextView
                        android:id="@+id/period7_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/widget_text_primary"
                        android:ellipsize="end"
                        android:maxLines="1"/>
                        
                    <TextView
                        android:id="@+id/period7_classroom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textSize="11sp"
                        android:textColor="@color/widget_text_secondary"
                        android:ellipsize="end"
                        android:maxLines="1"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/period7_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="19:30-21:00"
                    android:textSize="10sp"
                    android:textColor="@color/widget_text_secondary"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
