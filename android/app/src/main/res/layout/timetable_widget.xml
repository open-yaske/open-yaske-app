<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="8dp">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical">
        
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="今日の時間割"
            android:textColor="@color/widget_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />
            
        <TextView
            android:id="@+id/widget_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-"
            android:textColor="@color/widget_text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/header_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/widget_divider" />

    <!-- Scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <!-- Period 1 -->
            <LinearLayout
                android:id="@+id/period1_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="6dp"
                android:gravity="center_vertical">
                
                <TextView
                    android:id="@+id/period1_number"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:gravity="center"
                    android:text="1"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_text_primary"
                    android:background="@drawable/widget_period_circle"/>
                    
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">
                    
                    <TextView
                        android:id="@+id/period1_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/widget_text_primary"
                        android:ellipsize="end"
                        android:maxLines="1"/>
                        
                    <TextView
                        android:id="@+id/period1_classroom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textSize="11sp"
                        android:textColor="@color/widget_text_secondary"
                        android:ellipsize="end"
                        android:maxLines="1"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/period1_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="09:00-10:30"
                    android:textSize="10sp"
                    android:textColor="@color/widget_text_secondary"/>
            </LinearLayout>

            <View
                android:id="@+id/period1_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/widget_divider" />

            <!-- Period 2 -->
            <LinearLayout
                android:id="@+id/period2_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="6dp"
                android:gravity="center_vertical">
                
                <TextView
                    android:id="@+id/period2_number"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:gravity="center"
                    android:text="2"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_text_primary"
                    android:background="@drawable/widget_period_circle"/>
                    
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">
                    
                    <TextView
                        android:id="@+id/period2_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/widget_text_primary"
                        android:ellipsize="end"
                        android:maxLines="1"/>
                        
                    <TextView
                        android:id="@+id/period2_classroom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textSize="11sp"
                        android:textColor="@color/widget_text_secondary"
                        android:ellipsize="end"
                        android:maxLines="1"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/period2_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="10:40-12:10"
                    android:textSize="10sp"
                    android:textColor="@color/widget_text_secondary"/>
            </LinearLayout>

            <View
                android:id="@+id/period2_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/widget_divider" />

            <!-- Period 3 -->
            <LinearLayout
                android:id="@+id/period3_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="6dp"
                android:gravity="center_vertical">
                
                <TextView
                    android:id="@+id/period3_number"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:gravity="center"
                    android:text="3"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_text_primary"
                    android:background="@drawable/widget_period_circle"/>
                    
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">
                    
                    <TextView
                        android:id="@+id/period3_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/widget_text_primary"
                        android:ellipsize="end"
                        android:maxLines="1"/>
                        
                    <TextView
                        android:id="@+id/period3_classroom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textSize="11sp"
                        android:textColor="@color/widget_text_secondary"
                        android:ellipsize="end"
                        android:maxLines="1"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/period3_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="13:00-14:30"
                    android:textSize="10sp"
                    android:textColor="@color/widget_text_secondary"/>
            </LinearLayout>

            <View
                android:id="@+id/period3_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/widget_divider" />

            <!-- Period 4 -->
            <LinearLayout
                android:id="@+id/period4_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="6dp"
                android:gravity="center_vertical">
                
                <TextView
                    android:id="@+id/period4_number"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:gravity="center"
                    android:text="4"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/widget_text_primary"
                    android:background="@drawable/widget_period_circle"/>
                    
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">
                    
                    <TextView
                        android:id="@+id/period4_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
