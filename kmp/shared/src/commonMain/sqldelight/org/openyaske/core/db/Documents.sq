CREATE TABLE scan_templates (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    pattern TEXT NOT NULL,
    is_default INTEGER NOT NULL DEFAULT 0 CHECK (is_default IN (0, 1)),
    created_at_ms INTEGER NOT NULL
);

selectScanTemplates:
SELECT * FROM scan_templates ORDER BY is_default DESC, created_at_ms;

insertScanTemplate:
INSERT OR IGNORE INTO scan_templates(id, name, pattern, is_default, created_at_ms)
VALUES (?, ?, ?, ?, ?);

updateScanTemplate:
UPDATE scan_templates SET name = ?, pattern = ?, is_default = ? WHERE id = ?;

deleteScanTemplate:
DELETE FROM scan_templates WHERE id = ?;

CREATE TABLE scanned_documents (
    id TEXT NOT NULL PRIMARY KEY,
    course_id TEXT REFERENCES courses(id) ON DELETE SET NULL,
    session_id TEXT REFERENCES course_sessions(id) ON DELETE SET NULL,
    file_path TEXT NOT NULL,
    page_count INTEGER NOT NULL DEFAULT 1,
    size_bytes INTEGER NOT NULL DEFAULT 0,
    template_id TEXT REFERENCES scan_templates(id) ON DELETE SET NULL,
    created_at_ms INTEGER NOT NULL
);

selectScannedDocuments:
SELECT * FROM scanned_documents ORDER BY created_at_ms DESC;

selectScannedDocumentsByCourse:
SELECT * FROM scanned_documents WHERE course_id = ? ORDER BY created_at_ms DESC;

upsertScannedDocument:
INSERT OR REPLACE INTO scanned_documents(
    id, course_id, session_id, file_path, page_count, size_bytes, template_id, created_at_ms
) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

deleteScannedDocument:
DELETE FROM scanned_documents WHERE id = ?;
